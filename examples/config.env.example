# FRED reference environment template.
# Copy to .env, fill in YOUR values, NEVER commit the filled file.

# LLM provider (OpenAI-compatible)
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.example-provider.com/v1
LLM_MODEL=YOUR_MODEL_ID

# Text-to-speech provider
TTS_API_KEY=YOUR_TTS_API_KEY
TTS_MODEL_ID=YOUR_TTS_VOICE_ID

# Gateway auth
GATEWAY_TOKEN=YOUR_LONG_RANDOM_TOKEN
GATEWAY_PORT=18900

# Web UI
WEB_PORT=8765

# Bridge session key (bumped on rotation, e.g. assistant-v1)
SESSION_KEY=agent:main:assistant-v1
